[Desktop Entry]
Type=Application
Version=1.0
Name=CandySole
GenericName=Terminal
Comment=A colorful terminal for GraceOS
Exec=candysole
Icon=org.graceos.CandySole
Terminal=false
Categories=System;TerminalEmulator;Utility;
Keywords=terminal;shell;command;console;
StartupNotify=true
StartupWMClass=org.graceos.CandySole
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=candysole --new-window
